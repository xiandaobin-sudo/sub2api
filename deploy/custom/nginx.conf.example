# Include at nginx http{} scope. Run nginx on the host of the loopback app ports.
# Replace every example.invalid hostname and certificate path before enabling.
map $http_upgrade $sub2api_connection_upgrade {
    default upgrade;
    ''      '';
}
server {
    listen 80;
    server_name cn.example.invalid global.example.invalid;
    return 308 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name cn.example.invalid;
    ssl_certificate /etc/nginx/tls/cn.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/cn.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 256m;
    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header True-Client-IP "";
        proxy_set_header Forwarded "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $sub2api_connection_upgrade;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
server {
    listen 443 ssl;
    server_name global.example.invalid;
    ssl_certificate /etc/nginx/tls/global.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/global.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 256m;
    location / {
        proxy_pass http://127.0.0.1:28080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header True-Client-IP "";
        proxy_set_header Forwarded "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $sub2api_connection_upgrade;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
