COMPOSE_PROJECT_NAME=sub2api-cn
APP_PORT=18080
# Fill with the same repo@sha256:digest as the Global site.
APP_IMAGE=
SITE_CONFIG=./cn/site.json
TZ=Asia/Shanghai
POSTGRES_USER=sub2api
POSTGRES_DB=sub2api
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Exact proxy source address as seen INSIDE this app container; see README.
SERVER_TRUSTED_PROXIES=
